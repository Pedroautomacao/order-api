# Copie para .env e preencha com os valores reais do ambiente. O .env não vai
# para o Git (.gitignore) nem para a imagem Docker (.dockerignore) — o
# docker-compose o injeta como variáveis de ambiente em runtime.

# DATABASE
# Produção (VPS): o host é o NOME DO CONTAINER do PostgreSQL na rede proxy_net.
# Nunca localhost — dentro do container, localhost é o próprio order_api.
# Caracteres especiais na senha (@ : / ? # %) precisam ser percent-encoded.
DATABASE_URL=postgresql+psycopg://order_user:TROQUE_ESTA_SENHA@postgres-central:5432/order_api

# Teste local com Docker Desktop apontando para o Postgres da máquina host:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/order_api

# Execução sem Docker (venv local):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/order_api

# SECRET KEY
# Assina os JWT. Gere um valor exclusivo por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GERE_UM_VALOR_ALEATORIO_AQUI

# JWT — opcionais, os defaults do app já valem
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens de navegador autorizadas, separadas por vírgula.
# Só é necessário quando o frontend é servido em uma origem DIFERENTE da API.
# Na topologia com Nginx Proxy Manager (frontend em http://HOST/ e API em
# http://HOST/api) a origem é a mesma e o CORS não entra em jogo.
# O default do app são as portas de desenvolvimento (3000/3001).
# CORS_ORIGINS=https://app.exemplo.com

# ROOT_PATH — prefixo público quando a API é servida sob um subcaminho no proxy
# reverso. Só afeta as URLs que /docs e /openapi.json montam; as rotas do
# backend continuam sem prefixo. Use /api se o proxy expor a API em /api.
# ROOT_PATH=/api
